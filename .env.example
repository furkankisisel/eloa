# Eloa - Environment Variables Example
# Copy this file or pass these arguments using --dart-define when building/running.

# Google Gemini API Key (Multimodal Vision & NLP)
# Get yours at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Llama 3.3 70B Fast Inference)
# Get yours at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Usage:
# flutter run --dart-define=GEMINI_API_KEY=xxx --dart-define=GROQ_API_KEY=yyy
# flutter build apk --release --dart-define=GEMINI_API_KEY=xxx --dart-define=GROQ_API_KEY=yyy
